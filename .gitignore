*.zip
*.tar.gz
node_modules/
.DS_Store

.ssh/
*.key
.env

# Ignore Zsh completion cache/dumps
.zcompdump*
zcompdump*

# Ignore command history (contains sensitive info/tokens)
.zsh_history
.zsh_sessions/

# Ignore Antidote generated files
zsh/.config/zsh/plugins.zsh

# Ignore PNPM home and store
zsh/.config/zsh/pnpm/

# Ignore Zsh sessions
zsh/.config/zsh/.zsh_sessions/

# Ignore tmux plugins
tmux/.config/tmux/plugins/*
